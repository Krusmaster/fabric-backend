{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Krusmaster/fabric-backend/fabric_backend/packs/pack.schema.json",
  "title": "Krusgraph knowledge pack",
  "description": "Tables, keys and relationships of a known source system, with a source per claim. Independent of how the data arrives (mirroring, Databricks, Data API builder, a pipeline). Packs: sap (SAP ERP), younium_salesforce (Younium subscription billing beside Salesforce).",
  "type": "object",
  "required": [
    "pack",
    "module",
    "format_version",
    "title",
    "rule",
    "status",
    "variants",
    "sources",
    "tables",
    "relationships"
  ],
  "additionalProperties": false,
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_/]*$"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "amount": {
      "type": "object",
      "required": [
        "column",
        "level",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/definitions/name"
        },
        "level": {
          "enum": [
            "header",
            "item",
            "schedule_line"
          ]
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quantity": {
      "type": "object",
      "required": [
        "column",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/definitions/name"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "pack": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "format_version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "documented",
        "verified"
      ]
    },
    "status_note": {
      "type": "string"
    },
    "client_column": {
      "$ref": "#/definitions/name"
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "url",
          "publisher",
          "fetched"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "publisher": {
            "type": "string"
          },
          "fetched": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "level",
          "en",
          "key",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/definitions/name"
          },
          "level": {
            "enum": [
              "header",
              "item",
              "schedule_line",
              "version",
              "master",
              "text",
              "organization",
              "status",
              "partner",
              "document_flow"
            ],
            "description": "version: one row per version of a header (a Younium subscription version); the header's amounts and dates are read from the version valid on a date, never summed over versions."
          },
          "en": {
            "type": "string"
          },
          "de": {
            "type": "string",
            "description": "A German name, for packs of systems documented in German (SAP). Optional."
          },
          "key": {
            "$ref": "#/definitions/columns"
          },
          "key_note": {
            "type": "string"
          },
          "number_columns": {
            "$ref": "#/definitions/columns"
          },
          "delta": {
            "$ref": "#/definitions/columns"
          },
          "amounts": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/amount"
            }
          },
          "quantities": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/quantity"
            }
          },
          "currency_columns": {
            "$ref": "#/definitions/columns"
          },
          "unit_columns": {
            "$ref": "#/definitions/columns"
          },
          "variants": {
            "$ref": "#/definitions/variants"
          },
          "note": {
            "type": "string"
          },
          "sources": {
            "$ref": "#/definitions/source_ids"
          },
          "unique_keys": {
            "type": "array",
            "description": "Column sets that are unique in the table besides its key (VBAK: MANDT+KNUMV); a relationship of kind unique points at one of them.",
            "items": {
              "$ref": "#/definitions/columns"
            }
          },
          "personal": {
            "type": "array",
            "description": "Columns that hold personal data (customers and suppliers can be people), by the privacy rule they fall under (P1 name, P2 e-mail, P3 telephone, P4 national id, P5 address, P6 birth date). sample_rows masks them like any column the name rules flag.",
            "items": {
              "type": "object",
              "required": [
                "column",
                "rule"
              ],
              "additionalProperties": false,
              "properties": {
                "column": {
                  "$ref": "#/definitions/name"
                },
                "rule": {
                  "enum": [
                    "P1",
                    "P2",
                    "P3",
                    "P4",
                    "P5",
                    "P6"
                  ]
                }
              }
            }
          },
          "sv": {
            "type": "string",
            "description": "A Swedish name, for packs of systems documented in Swedish (Younium). Optional."
          },
          "common_name": {
            "type": "boolean",
            "description": "The table's name is an ordinary word that another system's table can carry too (ACCOUNTS, INVOICES, Contact). sap_pack.match_any, which the engine calls, takes a pack only when at least one of the tables it recognises is not marked so: a schema with a few tables called accounts, products and invoices is not read as Younium. Absent means false (every SAP table name is the system's own)."
          },
          "area": {
            "type": "string",
            "minLength": 1,
            "description": "The part of the business the table belongs to, in the system's own words (customers, subscriptions, billing, product catalog, sales). The domain proposal (domains.py) names a proposed domain after the areas of the pack tables in it, as it names SAP domains after their part of order-to-cash."
          },
          "source_name": {
            "type": "string",
            "minLength": 1,
            "description": "The name as the source system spells it, when the pack's upper-case name differs: a released CDS view (I_SalesDocument for I_SALES_DOCUMENT). Names are compared without case and underscores, so the pack's name reads the source's."
          },
          "aliases": {
            "$ref": "#/definitions/columns",
            "description": "Other names a landing gives the table: a CDS view without its I_ prefix (SALES_DOCUMENT for I_SalesDocument). Compared without case and underscores; the key columns must be there as for the name itself."
          },
          "common_alias": {
            "type": "boolean",
            "description": "An alias of the table is an ordinary word another system's table can carry (Customer, Product). Found by its alias, the table does not make a schema this pack's on its own (sap_pack.distinctive); found by its own name it does."
          },
          "source_columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "description": "The columns the pack names on the table in the source's own spelling (SalesDocumentItem for SALES_DOCUMENT_ITEM). Every column the pack uses on the table must be among them (sap_pack.problems)."
          },
          "corresponds_to": {
            "type": "object",
            "required": [
              "table",
              "sources"
            ],
            "additionalProperties": false,
            "description": "The table of the same pack whose rows the view reads (I_SalesDocument ~ VBAK), with what differs and the source of the statement. A mapping for a person; the engine does not join through it.",
            "properties": {
              "table": {
                "$ref": "#/definitions/name"
              },
              "note": {
                "type": "string"
              },
              "sources": {
                "$ref": "#/definitions/source_ids"
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "source_cols",
          "target",
          "target_cols",
          "cardinality",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "#/definitions/name"
          },
          "source_cols": {
            "$ref": "#/definitions/columns"
          },
          "target": {
            "$ref": "#/definitions/name"
          },
          "target_cols": {
            "$ref": "#/definitions/columns"
          },
          "cardinality": {
            "enum": [
              "many-to-one",
              "one-to-one",
              "many-to-many"
            ]
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "condition": {
            "type": "string"
          },
          "apply": {
            "type": "boolean"
          },
          "variants": {
            "$ref": "#/definitions/variants"
          },
          "sources": {
            "$ref": "#/definitions/source_ids"
          },
          "kind": {
            "enum": [
              "key",
              "unique",
              "valid_on"
            ],
            "description": "key (default): equality on the target's key. unique: equality on a unique_keys entry of the target. valid_on: equality on the target's key without its valid-to column, plus source_date between target_from and target_to."
          },
          "valid_on": {
            "type": "object",
            "required": [
              "target_from",
              "target_to"
            ],
            "additionalProperties": false,
            "description": "The target row whose period holds a date: the source row's source_date, or with on: today the date of the call.",
            "properties": {
              "source_date": {
                "$ref": "#/definitions/name"
              },
              "on": {
                "const": "today"
              },
              "target_from": {
                "$ref": "#/definitions/name"
              },
              "target_to": {
                "$ref": "#/definitions/name"
              }
            }
          },
          "where": {
            "type": "array",
            "minItems": 1,
            "description": "For which rows the join holds: a column of the source or the target and the values it must have (VBFA.VBTYP_N in J, T for deliveries). A filtered relationship is applied as a join with these conditions.",
            "items": {
              "type": "object",
              "required": [
                "side",
                "column"
              ],
              "additionalProperties": false,
              "properties": {
                "side": {
                  "enum": [
                    "source",
                    "target"
                  ]
                },
                "column": {
                  "$ref": "#/definitions/name"
                },
                "in": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "blank": {
                  "const": true,
                  "description": "SAP's blank: NULL, '' or ' ', however the tool wrote it (ADRC.NATION, the standard version)."
                }
              }
            }
          },
          "verified": {
            "type": "array",
            "description": "Runs of validate_plan in which the relationship held for every row with a value: where (described without naming a company) and when. Written by fabric-backend sap-verify --write.",
            "items": {
              "type": "object",
              "required": [
                "where",
                "when",
                "rows_with_value"
              ],
              "additionalProperties": false,
              "properties": {
                "where": {
                  "type": "string",
                  "minLength": 3
                },
                "when": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "rows_with_value": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "association": {
            "type": "string",
            "minLength": 1,
            "description": "The CDS association(s) the relationship is written from, with the cardinality the view declares: 'I_SalesDocumentItem._SalesDocument [1..1]; I_SalesDocument._Item [0..*]'."
          }
        }
      }
    },
    "traps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "text",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sources": {
            "$ref": "#/definitions/source_ids"
          }
        }
      }
    }
  }
}
