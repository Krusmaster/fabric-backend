{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Krusmaster/fabric-backend/fabric_backend/packs/manifest.schema.json",
  "title": "Krusgraph knowledge pack manifest",
  "description": "One file per pack, packs/<pack>/manifest.yaml: what the pack claims (entities, candidate relationships, traps), where each claim comes from (sources, verified or not), which check on the rows can confirm it, which synthetic fixture exercises it, and whether a person has reviewed it. The sections sources, entities, candidate_relationships and traps are derived from the pack's module files (fabric_backend/pack_manifest.py); the rest is kept by hand. Format: docs/PACKS.md.",
  "type": "object",
  "required": ["id", "version", "title", "source_systems", "scope", "sharing", "rule", "variants", "modules", "sources", "entities",
               "candidate_relationships", "traps", "fixtures", "review_status", "reviewed_by", "reviewed_at"],
  "additionalProperties": false,
  "definitions": {
    "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_/]*$"},
    "ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9_/]*\\.[A-Z][A-Z0-9_/]*(\\+[A-Z][A-Z0-9_/]*)*$",
            "description": "TABLE.COLUMN or TABLE.COLUMN+COLUMN: a table and the columns of one side of a relationship, in order."},
    "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/name"}},
    "ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  },
  "properties": {
    "id": {"$ref": "#/definitions/slug", "description": "The pack's directory name under packs/."},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "major.minor.patch of the manifest's content; 0.x while review_status is proposed."},
    "title": {"type": "string", "minLength": 1},
    "source_systems": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "The systems the pack describes, by their public names."},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "description": "The business processes covered (order-to-cash, procure-to-pay, subscription-billing, ...)."},
    "sharing": {"enum": ["public-synthetic"], "description": "What the pack and its fixtures may contain: public sources and synthetic rows only, never customer data."},
    "rule": {"type": "string", "minLength": 1, "description": "The rule label the engine writes on a relationship taken from this pack."},
    "variants": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "modules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["module", "title", "status", "file"], "additionalProperties": false,
                "properties": {"module": {"$ref": "#/definitions/slug"}, "title": {"type": "string"}, "status": {"enum": ["documented", "verified"]}, "file": {"type": "string"}}}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "url", "publisher", "accessed", "verified"], "additionalProperties": false,
                "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"},
                               "publisher": {"type": "string"},
                               "accessed": {"oneOf": [{"$ref": "#/definitions/date"}, {"type": "null"}], "description": "The date the page was read, when it was; null when it was not opened."},
                               "verified": {"type": "boolean", "description": "true only when the page was read and the claims checked against it."},
                               "note": {"type": "string"}}}},
    "entities": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "module", "level", "title", "key", "sources"], "additionalProperties": false,
                 "properties": {"name": {"$ref": "#/definitions/name"}, "module": {"$ref": "#/definitions/slug"},
                                "level": {"enum": ["header", "item", "schedule_line", "version", "master", "text", "organization", "status", "partner", "document_flow"]},
                                "title": {"type": "string"},
                                "key": {"$ref": "#/definitions/columns", "description": "The key candidate the pack applies."},
                                "unique_keys": {"type": "array", "items": {"$ref": "#/definitions/columns"}, "description": "Further key candidates: column sets unique in the table besides the key."},
                                "amounts": {"type": "array", "items": {"type": "object", "required": ["column", "level", "currency"], "additionalProperties": false,
                                            "properties": {"column": {"$ref": "#/definitions/name"}, "level": {"enum": ["header", "item", "schedule_line"]}, "currency": {"type": "string"}}}},
                                "variants": {"$ref": "#/definitions/ids"}, "area": {"type": "string"}, "note": {"type": "string"},
                                "sources": {"$ref": "#/definitions/ids"}}}},
    "candidate_relationships": {"type": "array", "items": {"type": "object",
                                "required": ["from", "to", "cardinality", "kind", "module", "rule", "applied", "validation", "sources"], "additionalProperties": false,
                                "properties": {"from": {"$ref": "#/definitions/ref"}, "to": {"$ref": "#/definitions/ref"},
                                               "cardinality": {"enum": ["many-to-one", "one-to-one", "many-to-many"]},
                                               "kind": {"enum": ["key", "unique", "valid_on"]}, "module": {"$ref": "#/definitions/slug"},
                                               "rule": {"type": "string", "minLength": 1},
                                               "applied": {"type": "boolean", "description": "false: listed with its condition, not planned (applying it would show orphans by design)."},
                                               "role": {"$ref": "#/definitions/slug"}, "condition": {"type": "string"}, "variants": {"$ref": "#/definitions/ids"},
                                               "where": {"type": "array"}, "valid_on": {"type": "object"},
                                               "verified": {"type": "array", "items": {"type": "object", "required": ["where", "when", "rows_with_value"]}},
                                               "validation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["referential_integrity", "cardinality", "amount_level"]},
                                                              "description": "Which of validate_plan's checks can confirm the relationship on the rows: orphans, rows matching more than one target row, header amounts a join repeats."},
                                               "sources": {"$ref": "#/definitions/ids"}}}},
    "traps": {"type": "array", "items": {"type": "object", "required": ["name", "title", "description", "module", "sources", "check"], "additionalProperties": false,
              "properties": {"name": {"$ref": "#/definitions/slug"}, "title": {"type": "string"}, "description": {"type": "string"}, "module": {"$ref": "#/definitions/slug"},
                             "sources": {"$ref": "#/definitions/ids"},
                             "check": {"enum": ["referential_integrity", "amount_level", "privacy", "manual"],
                                       "description": "The automated check that shows the trap on the rows: validate_plan's orphans and several matches on the pack relationship that encodes it, its amount_levels (the total that doubles), the privacy rules (sample_rows masks the columns the pack names), or manual: no check; the description is the check."}}}},
    "fixtures": {"type": "object", "required": ["module", "tables", "sqlite", "expected", "facit", "facit_set"], "additionalProperties": false,
                 "description": "The synthetic module that builds the pack's tables with rows (never customer data), what it says the checks should find, and the benchmark facit the pack's relationships are compared with.",
                 "properties": {"module": {"type": "string", "pattern": "^fabric_backend\\.[a-z_]+$"}, "tables": {"type": "string"}, "sqlite": {"type": "string"},
                                "expected": {"type": "string"}, "facit": {"type": "string"}, "facit_set": {"type": "string"}}},
    "review_status": {"enum": ["proposed", "reviewed"]},
    "reviewed_by": {"type": "string", "description": "Empty until the maintainer has reviewed the manifest."},
    "reviewed_at": {"oneOf": [{"const": ""}, {"$ref": "#/definitions/date"}]}
  }
}
