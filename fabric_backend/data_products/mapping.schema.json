{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Krusgraph knowledge packs mapped to the catalog of data products (round DP1)",
 "description": "fabric_backend/data_products/mapping.yaml. Checked against the pack manifests by data_product_catalog.mapping_problems.",
 "type": "object",
 "required": [
  "version",
  "sources",
  "packs"
 ],
 "additionalProperties": false,
 "properties": {
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "sources": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "title",
     "pack",
     "modules"
    ],
    "additionalProperties": false,
    "properties": {
     "title": {
      "type": "string"
     },
     "pack": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     }
    }
   }
  },
  "not_in_pack": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "propertyNames": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]*$"
    },
    "additionalProperties": {
     "type": "string"
    }
   }
  },
  "packs": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "tables",
     "not_a_data_product"
    ],
    "additionalProperties": false,
    "properties": {
     "inherit": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "module -> the pack whose mapping its tables take"
     },
     "tables": {
      "type": "object",
      "additionalProperties": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "product",
         "role",
         "key",
         "confidence",
         "evidence"
        ],
        "additionalProperties": false,
        "properties": {
         "product": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
         },
         "role": {
          "enum": [
           "header",
           "line",
           "master",
           "extension",
           "text",
           "version",
           "bridge",
           "schedule_line",
           "status",
           "flow",
           "snapshot"
          ]
         },
         "key": {
          "type": "object",
          "propertyNames": {
           "type": "string",
           "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
           "type": "string"
          },
          "description": "Business-key name of the product -> the pack's column."
         },
         "confidence": {
          "enum": [
           "high",
           "medium",
           "low"
          ]
         },
         "evidence": {
          "enum": [
           "verified",
           "partly_verified",
           "unverified"
          ],
          "description": "What the pack's own sources say: derived, checked by mapping_problems."
         },
         "note": {
          "type": "string"
         }
        }
       }
      }
     },
     "not_a_data_product": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "kind",
        "reason"
       ],
       "additionalProperties": false,
       "properties": {
        "kind": {
         "enum": [
          "helper",
          "outside_catalog"
         ]
        },
        "reason": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    }
   }
  }
 }
}
