exports[`WB11: the data product, Retire, the catalog and the source > the Built list names each item's type with its icon 1`] = `
"<div class="kg-dp" aria-busy="false"><style>
.kg-dp{--kg-fg:var(--colorNeutralForeground1,#1f1f1f);--kg-fg2:var(--colorNeutralForeground2,#424242);
--kg-bg:var(--colorNeutralBackground1,#ffffff);--kg-bg2:var(--colorNeutralBackground2,#f5f5f5);
--kg-line:var(--colorNeutralStroke1,#c7c7c7);--kg-brand:var(--colorBrandBackground,#0f6cbd);--kg-on-brand:var(--colorNeutralForegroundOnBrand,#ffffff);
--kg-ok:#0e700e;--kg-bad:#b10e1c;--kg-warn:#8a3707;--kg-wait:#3b3a39;--kg-focus:var(--colorStrokeFocus2,#000000);
color:var(--kg-fg);background:var(--kg-bg);font-family:var(--fontFamilyBase,&quot;Segoe UI&quot;,system-ui,sans-serif);font-size:14px;line-height:1.45;
box-sizing:border-box;max-width:960px;padding:16px;overflow-wrap:anywhere}
@media (prefers-color-scheme:dark){.kg-dp{--kg-fg:var(--colorNeutralForeground1,#f0f0f0);--kg-fg2:var(--colorNeutralForeground2,#d6d6d6);
--kg-bg:var(--colorNeutralBackground1,#1f1f1f);--kg-bg2:var(--colorNeutralBackground2,#2b2b2b);--kg-line:var(--colorNeutralStroke1,#666666);
--kg-brand:var(--colorBrandBackground,#115ea3);--kg-ok:#6ccb5f;--kg-bad:#ff99a4;--kg-warn:#fce100;--kg-wait:#d6d6d6;--kg-focus:var(--colorStrokeFocus2,#ffffff)}}
.kg-dp *{box-sizing:border-box}
.kg-dp h2{font-size:20px;margin:0 0 4px}.kg-dp h3{font-size:16px;margin:0 0 8px}
.kg-dp section{border-top:1px solid var(--kg-line);padding:12px 0;margin:0}
.kg-dp p{margin:4px 0}.kg-dp .kg-dp-muted{color:var(--kg-fg2)}
.kg-dp ul{list-style:none;margin:8px 0;padding:0}
.kg-dp li.kg-dp-row{display:flex;flex-wrap:wrap;gap:4px 12px;align-items:baseline;padding:8px;border:1px solid var(--kg-line);border-radius:4px;margin:0 0 8px;background:var(--kg-bg2)}
.kg-dp .kg-dp-state{font-weight:600}
.kg-dp .kg-dp-mark{display:inline-block;min-width:1.4em;text-align:center;border-radius:3px;margin-right:4px;font-weight:700}
.kg-dp .tone-ok{color:var(--kg-ok)}.kg-dp .tone-bad{color:var(--kg-bad)}.kg-dp .tone-warn{color:var(--kg-warn)}
.kg-dp .tone-wait,.kg-dp .tone-off{color:var(--kg-wait)}
.kg-dp .kg-dp-name{font-weight:600}.kg-dp .kg-dp-why{flex-basis:100%;color:var(--kg-fg2)}
.kg-dp .kg-dp-actions{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}
.kg-dp button{font:inherit;min-height:32px;padding:4px 12px;border-radius:4px;border:1px solid var(--kg-line);background:var(--kg-bg);color:var(--kg-fg);cursor:pointer}
.kg-dp button.kg-dp-primary{background:var(--kg-brand);border-color:var(--kg-brand);color:var(--kg-on-brand)}
.kg-dp button.kg-dp-small{padding:2px 10px}
.kg-dp button.kg-dp-danger{border-color:var(--kg-bad);color:var(--kg-bad);background:var(--kg-bg)}
.kg-dp button:disabled{opacity:.55;cursor:not-allowed}
.kg-dp button:focus-visible,.kg-dp input:focus-visible,.kg-dp select:focus-visible,.kg-dp summary:focus-visible{outline:2px solid var(--kg-focus);outline-offset:2px}
.kg-dp label{display:inline-flex;gap:6px;align-items:center}
.kg-dp .krusgraph-item-title{display:inline-flex;align-items:center;gap:6px;align-self:center}
.kg-dp .krusgraph-item-icon{width:20px;height:20px;flex:none}
.kg-dp input[type=text]{font:inherit;min-height:32px;padding:4px 8px;border:1px solid var(--kg-line);border-radius:4px;background:var(--kg-bg);color:var(--kg-fg);width:100%;max-width:360px}
.kg-dp .kg-dp-field{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}
.kg-dp .kg-dp-field&gt;label{display:block;flex-basis:100%;font-weight:600}
.kg-dp .kg-dp-note{border-left:4px solid var(--kg-warn);padding:4px 8px;background:var(--kg-bg2);margin:8px 0}
.kg-dp .kg-dp-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.kg-dp .kg-dp-facts{display:grid;grid-template-columns:minmax(0,1fr);gap:2px}
@media (min-width:640px){.kg-dp .kg-dp-facts{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
.kg-dp .kg-dp-saved{display:flex;gap:6px;align-items:baseline;font-weight:600;margin:4px 0 8px}
.kg-dp details summary{cursor:pointer;min-height:32px;padding:4px 0}
@media (max-width:600px),(pointer:coarse){.kg-dp{padding:12px}
.kg-dp button,.kg-dp input[type=text],.kg-dp details summary{min-height:44px}
.kg-dp label{min-height:44px;display:flex;align-items:center}.kg-dp input[type=checkbox]{width:24px;height:24px}
.kg-dp .kg-dp-actions button,.kg-dp .kg-dp-field button{flex:1 1 100%}
.kg-dp input[type=text]{max-width:none}}
</style><h2>Data product: Shop sales</h2><div class="kg-dp-facts"><p>Owner: Anna Berg (anna@example.com) (chosen on 2026-11-10 10:00 UTC by Anna Berg).</p><p>Health: not checked yet</p><p>Last pipeline run: succeeded, demo_lh_pipeline, started 2026-11-10 09:06 UTC.</p><p>Plan id: plan-0123abcd.</p></div><p class="kg-dp-muted" aria-live="polite">4 built, 1 pending, 1 failed, 1 changed outside Krusgraph, 1 missing, 1 removed</p><div class="kg-dp-actions"><button type="button" class="kg-dp-small" aria-label="Read Fabric again">Refresh</button></div><section aria-labelledby="kg-dp-owner"><h3 id="kg-dp-owner">Owner</h3><div class="kg-dp-field"><label for="kg-dp-owner-input">The person or group who answers for this data product</label><input id="kg-dp-owner-input" type="text" list="kg-dp-people" autoComplete="off" placeholder="Start typing a name" value="Anna Berg (anna@example.com)"/><datalist id="kg-dp-people"><option value="Anna Berg (anna@example.com)">Anna Berg, Admin</option><option value="Sales team">Sales team, group</option></datalist><button type="button" disabled="">Save owner</button><button type="button">Me (Anna Berg)</button></div><p>The owner is the person people ask when a number in this data product looks wrong, and who decides on Update and Retire.</p><p class="kg-dp-muted">2 people and groups have a role in this workspace.</p></section><section aria-labelledby="kg-dp-items"><h3 id="kg-dp-items">Items</h3><p class="kg-dp-saved" data-saved="loaded" aria-live="polite"><span class="kg-dp-mark tone-ok" aria-hidden="true">✓</span><span>Saved: this list is what this item keeps in Fabric.</span></p><p class="kg-dp-muted">Every item plan plan-0123abcd built, from every Create of this item.</p><ul><li class="kg-dp-row" data-state="built"><span class="kg-dp-state tone-ok"><span class="kg-dp-mark" aria-hidden="true">✓</span>Built</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/notebook_24_item.svg" alt="" width="20" height="20"/>Notebook</span><span class="kg-dp-name">silver_shop</span><span class="kg-dp-actions"><button type="button" class="kg-dp-open">Open in Fabric<span class="kg-dp-sr">: silver_shop</span><span class="kg-dp-sr"> (opens a new tab)</span></button><label><input type="checkbox"/>Choose silver_shop for Retire</label></span></li><li class="kg-dp-row" data-state="built"><span class="kg-dp-state tone-ok"><span class="kg-dp-mark" aria-hidden="true">✓</span>Built</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/pipeline_24_item.svg" alt="" width="20" height="20"/>Pipeline</span><span class="kg-dp-name">demo_lh_pipeline</span><span class="kg-dp-actions"><button type="button" class="kg-dp-open">Open in Fabric<span class="kg-dp-sr">: demo_lh_pipeline</span><span class="kg-dp-sr"> (opens a new tab)</span></button><label><input type="checkbox"/>Choose demo_lh_pipeline for Retire</label></span></li><li class="kg-dp-row" data-state="built"><span class="kg-dp-state tone-ok"><span class="kg-dp-mark" aria-hidden="true">✓</span>Built</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/semantic_model_24_item.svg" alt="" width="20" height="20"/>Semantic model</span><span class="kg-dp-name">demo_lh_model</span><span class="kg-dp-actions"><button type="button" class="kg-dp-open">Open in Fabric<span class="kg-dp-sr">: demo_lh_model</span><span class="kg-dp-sr"> (opens a new tab)</span></button><label><input type="checkbox"/>Choose demo_lh_model for Retire</label></span></li><li class="kg-dp-row" data-state="built"><span class="kg-dp-state tone-ok"><span class="kg-dp-mark" aria-hidden="true">✓</span>Built</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/report_24_item.svg" alt="" width="20" height="20"/>Report</span><span class="kg-dp-name">demo_lh_report</span><span class="kg-dp-actions"><button type="button" class="kg-dp-open">Open in Fabric<span class="kg-dp-sr">: demo_lh_report</span><span class="kg-dp-sr"> (opens a new tab)</span></button><label><input type="checkbox"/>Choose demo_lh_report for Retire</label></span></li><li class="kg-dp-row" data-state="missing"><span class="kg-dp-state tone-bad"><span class="kg-dp-mark" aria-hidden="true">?</span>Missing</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/generic_placeholder_24_item.svg" alt="" width="20" height="20"/>API for GraphQL</span><span class="kg-dp-name">demo_lh_api</span><span class="kg-dp-why">Fabric does not list it in the workspace any more (deleted, or moved outside Krusgraph).</span><span class="kg-dp-actions"><label><input type="checkbox"/>Choose demo_lh_api for Retire</label></span></li><li class="kg-dp-row" data-state="changed_outside"><span class="kg-dp-state tone-warn"><span class="kg-dp-mark" aria-hidden="true">!</span>Changed outside Krusgraph</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/ontology_24_item.svg" alt="" width="20" height="20"/>Ontology</span><span class="kg-dp-name">demo_lh_ontology</span><span class="kg-dp-why">Renamed in Fabric to sales_ontology.</span><span class="kg-dp-actions"><button type="button" class="kg-dp-open">Open in Fabric<span class="kg-dp-sr">: demo_lh_ontology</span><span class="kg-dp-sr"> (opens a new tab)</span></button><label><input type="checkbox"/>Choose demo_lh_ontology for Retire</label></span></li><li class="kg-dp-row" data-state="pending"><span class="kg-dp-state tone-wait"><span class="kg-dp-mark" aria-hidden="true">…</span>Pending</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/fabric_apps_24_item.svg" alt="" width="20" height="20"/>App</span><span class="kg-dp-name">demo_lh_app</span><span class="kg-dp-why">A Create sent it and has not seen it finish. Reopening the item or Try again adopts it once Fabric has made it.</span></li><li class="kg-dp-row" data-state="failed"><span class="kg-dp-state tone-bad"><span class="kg-dp-mark" aria-hidden="true">✕</span>Failed</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/data_agent_24_item.svg" alt="" width="20" height="20"/>Data agent</span><span class="kg-dp-name">demo_lh_agent</span><span class="kg-dp-why">Not built. Fix and finish on the result builds what is missing, reusing what exists.</span><span class="kg-dp-why"><button type="button" aria-expanded="false">Details</button></span></li></ul><details data-removed=""><summary>Removed (1)</summary><p class="kg-dp-muted">Deleted from Fabric by Retire; kept here as a record of what this data product had.</p><ul><li class="kg-dp-row" data-state="removed"><span class="kg-dp-state tone-off"><span class="kg-dp-mark" aria-hidden="true">–</span>Removed</span><span class="krusgraph-item-title"><img class="krusgraph-item-icon" src="/assets/fabric-icons/report_24_item.svg" alt="" width="20" height="20"/>Report</span><span class="kg-dp-name">demo_lh_report_2</span><span class="kg-dp-why">Deleted from Fabric on 2026-11-11 08:30 UTC by Anna Berg.</span></li></ul></details></section><section aria-labelledby="kg-dp-update"><h3 id="kg-dp-update">Update</h3><p>Counts the rows again and makes a dry run of every output: what is out of date, with Update (a dry run first, then your confirmation) or a new name. Nothing is written until you confirm.</p><div class="kg-dp-actions"><button type="button" class="kg-dp-primary">Check against the rows again</button></div></section><section aria-labelledby="kg-dp-retire"><h3 id="kg-dp-retire">Retire</h3><p>No item chosen above: Retire applies to the whole data product. Krusgraph never deletes a lakehouse, a warehouse, a table or a view&#x27;s data, and never an item this data product did not build.</p><div class="kg-dp-actions"><button type="button">1. Turn off: see what stops</button><button type="button" class="kg-dp-danger">2. Delete from Fabric: see the dry run</button></div></section><section aria-labelledby="kg-dp-left"><h3 id="kg-dp-left">Clean up leftovers</h3><p>Items in this workspace that carry Krusgraph&#x27;s plan marker but that no Krusgraph Model lists, such as one Fabric finished after a Create stopped waiting.</p><div class="kg-dp-actions"><button type="button">Look for leftovers</button></div></section></div>"
`;

exports[`WB11: the data product, Retire, the catalog and the source > the catalog's What would be written as you cards show the item's type and icon before its name 1`] = `"<section class="kg-catalog" aria-labelledby="kg-catalog-title"><h3 id="kg-catalog-title" class="fui-Subtitle2 fui-Text ___i24qii0_1tsayoq fk6fouc fod5ikn faaz57k fl43uef fpgzoln f1w7gpdv f6juhto f1gl81tg f2jf649"><svg aria-hidden="true" fill="currentColor" data-fui-icon="" class="fui-Icon ___9ctc0p0_1xvj9ao f1w7gpdv fez10in f1dd5bof" width="20" height="20" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M6 5a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm1 0v1h6V5zM4 4v12c0 1.1.9 2 2 2h3.5q-.32-.45-.45-1H6a1 1 0 0 1-1-1h4v-1H5V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v4.01q.51.03 1 .12V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2m13 5.42A7.86 7.86 0 0 0 14.5 9c-2.49 0-4.5 1.12-4.5 2.5s2.01 2.5 4.5 2.5 4.5-1.12 4.5-2.5c0-.87-.8-1.63-2-2.08m1.17 4.72c-1 .55-2.29.86-3.67.86s-2.68-.3-3.67-.86q-.45-.24-.83-.59v2.95c0 1.38 2.01 2.5 4.5 2.5s4.5-1.12 4.5-2.5v-2.95q-.38.35-.83.6" fill="currentColor"></path></svg> Publish to OneLake catalog</h3><span class="fui-Body1 fui-Text ___c56hd20_oafdhs0 fk6fouc fkhj508 f1i3iumi figsok6 fpgzoln f1w7gpdv f6juhto f1gl81tg f2jf649">Krusgraph fills the catalog for the data products it has checked: a description, tags, an owner, glossary terms and the row-check evidence. First you see exactly what would be written as you; nothing is written until you choose Write.</span><span data-ed3="owner" class="fui-Caption1 fui-Text ___13vod6f_1082073 fk6fouc fy9rknc fwrc4pm figsok6 fpgzoln f1w7gpdv f6juhto f1gl81tg f2jf649">No owner yet: set it under Owner above.</span><div class="kg-catalog-actions"><button type="button" class="fui-Button r1f29ykk ___dhqv000_ql4wmo0 ffp7eso f1p3nwhy f11589ue f1q5o8ev f1pdflbu f1phragk f15wkkf3 f1s2uweq fr80ssc f1ukrpxl fecsdlb f1rq72xc f1ksv2xa fhvnf4x fb6swo4 f1klyf7k f232fm2 f1d6mv4x f1nz3ub2 fag2qd2 fmvhcg7 f1o3dhpw f14bpyus fqc85l4 f1