{
  "name": "krusgraph-fabric-workload",
  "version": "2.0.0",
  "description": "Krusgraph Model: a Microsoft Fabric workload item (fork of microsoft/fabric-extensibility-toolkit at dacab1b, MIT)",
  "scripts": {
    "start": "npm run start:devServer",
    "start:devServer": "cross-env NODE_OPTIONS=--max-old-space-size=8192 env-cmd -f .env.dev webpack serve --open --config ./devServer/webpack.dev.js",
    "start:devGateway": "node ./devServer/start-devGateway.js",
    "start:codespace": "cross-env NODE_OPTIONS=--max-old-space-size=8192 env-cmd -f .env.dev webpack serve --open --config ./devServer/webpack.dev.js --no-hot",
    "build:test": "env-cmd -f .env.test webpack --config ./webpack.config.js --output-path ../build/Frontend --progress",
    "build:prod": "env-cmd -f .env.prod webpack --config ./webpack.config.js --output-path ../build/Frontend --mode production --progress",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fabric-msft/svg-icons": "12.0.0",
    "@fluentui/react": "^8.110.7",
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "2.0.345",
    "@ms-fabric/workload-client": "^3.1.1",
    "@reduxjs/toolkit": "^2.6.0",
    "history": "^5.3.0",
    "i18next": "^27.1.1",
    "i18next-http-backend": "^4.0.10",
    "jwt-decode": "^4.0.0",
    "process": "^0.11.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.2",
    "ajv": "^8.12.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "dotenv": "^18.0.10",
    "env-cmd": "^11.0.0",
    "express-rate-limit": "^8.7.4",
    "html-webpack-plugin": "^5.5.0",
    "jsdom": "31.0.0",
    "nuget-bin": "^4.0.0",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.2.6",
    "typescript": "^7.0.2",
    "vitest": "5.1.0",
    "webpack": "^5.90.3",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "private": true
}
