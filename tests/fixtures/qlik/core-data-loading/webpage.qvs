// Test fixture of Krusgraph, copied from github.com/qlik-oss/core-data-loading at commit 0b79c835e30af66f06590b93e5dfa4d4d8bc1ff5, file scripts/webpage.qvs. Licence: MIT, see LICENSE-core-data-loading.txt in this folder. This line was added; other changes are listed in ../SOURCES.md.
// This script shows a simple example of how to load data from a web page.
// The options on the last line specify how data from the web page shall be
// interpreted: that the that the file is in html format,
// which character endcoding that is used ('utf8')
// and that the delimiter is ','.


Airports:
    LOAD *
    FROM [lib://webdata]
    (html, utf8, delimiter is ',');
