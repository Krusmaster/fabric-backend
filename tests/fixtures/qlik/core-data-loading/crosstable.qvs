// Test fixture of Krusgraph, copied from github.com/qlik-oss/core-data-loading at commit 0b79c835e30af66f06590b93e5dfa4d4d8bc1ff5, file scripts/crosstable.qvs. Licence: MIT, see LICENSE-core-data-loading.txt in this folder. This line was added; other changes are listed in ../SOURCES.md.
// The CROSSTABLE prefix is used to turn a cross table into a straight table.
// If you for example have data with one column per month, the result of
// CROSSTABLE in the script below, is that the column headers (month names)
// are be stored in one field ('Month') and the column data (the month data)
// is stored in a second field ('Number').

CROSSTABLE (Month, Number, 1)
LOAD * INLINE [
    Country, Jan, Feb, Mar
    Sweden, 100, 200, 300
    Norway, 150, 100, 400
    Denmark, 200, 300, 100
];
