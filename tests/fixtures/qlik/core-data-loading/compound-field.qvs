// Test fixture of Krusgraph, copied from github.com/qlik-oss/core-data-loading at commit 0b79c835e30af66f06590b93e5dfa4d4d8bc1ff5, file scripts/compound-field.qvs. Licence: MIT, see LICENSE-core-data-loading.txt in this folder. This line was added; other changes are listed in ../SOURCES.md.
// This load script shows how several fields are combined into one field in the
// resulting table. The 'Date', 'Time', and 'Fraction' fields are concatenated
// to form the resulting 'CompoundTimestamp' field.

Timeseries:
    LOAD
        Date & 'T' & Time & '.' & Fraction AS CompoundTimestamp,
        Value
    FROM [lib://data/timeseries.csv];
