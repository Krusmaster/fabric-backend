table orders
	lineageTag: 6b1d0e44-0000-4000-8000-000000000003

	measure 'Orders Shipped' = CALCULATE ( COUNTROWS ( orders ), NOT ISBLANK ( orders[ship_to_id] ) )

	column order_id
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: order_id

	column ship_to_id
		dataType: int64
		summarizeBy: none
		sourceColumn: ship_to_id

	partition orders = entity
		mode: directLake
		source
			entityName: orders
			schemaName: shop
			expressionSource: DatabaseQuery
