table wind_turbine_telemetry_augmented_Mar2025
	lineageTag: 1477b3e1-008e-4fdd-aa22-6f3c804fdf85

	/// Mean instantaneous power output across turbine telemetry readings.
	measure 'Average Power' = AVERAGE('wind_turbine_telemetry_augmented_Mar2025'[Power])
		formatString: 0.00
		displayFolder: Telemetry
		lineageTag: a5c18132-3e7c-4a1d-b3f1-b6e9557d34b8

	/// Total energy produced (kWh) across turbine telemetry readings.
	measure 'Total Energy Kwh' = SUM('wind_turbine_telemetry_augmented_Mar2025'[EnergyKwh])
		formatString: #,0
		displayFolder: Telemetry
		lineageTag: 14dd08b0-f2d0-419f-bb99-f4d595958a1e

