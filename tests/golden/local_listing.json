 "answer_query_draft": {
  "annotations": {
   "destructive_hint": false,
   "open_world_hint": true,
   "read_only_hint": true
  },
  "description": "A question in Swedish or English about the given tables as T-SQL over the safest join path of the plan, each\nstep with the rule behind its relationship, plus what was read from the question and what was assumed. Columns that\nlook like personal data by name are left out (the key stands in) unless show_personal_data=true. Runs nothing; the\nGraphQL form needs an API in Fabric and is in the remote server.",
  "input_schema": {
   "properties": {
    "confirmed": {
     "anyOf": [
      {
       "items": {
        "additionalProperties": true,
        "type": "object"
       },
       "type": "array"
