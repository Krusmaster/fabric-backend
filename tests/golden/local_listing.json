         "type": "string"
        },
        "type": "array"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Keys"
    },
    "schema": {
     "default": "dbo",
     "title": "Schema",
     "type": "string"
    },
    "tables": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
