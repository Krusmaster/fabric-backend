      {
       "additionalProperties": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Keys"
    },
    "question": {
     "title": "Question",
     "type": "string"
    },
    "schema": {
     "default": "dbo",
     "title": "Schema",
     "type": "string"
    },
    "show_personal_data": {
     "default": false,
     "title": "Show Personal Data",
     "type": "boolean"
    },
    "tables": {
     "items": {
      "type": "string"
     },
     "title": "Tables",
     "type": "array"
    }
   },
   "required": [
    "question",
    "tables"
   ],
